{
  "manifest_version": 3,
  "name": "Themis Bridge",
  "version": "1.2.3",
  "description": "Ponte de sincronização direta entre a Pasta Digital do e-SAJ/TJSP e o Themis via Hermes Plugin API",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Themis Bridge"
  },
  "background": {
    "service_worker": "background.js"
  },
  "key": "",
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://esaj.tjsp.jus.br/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://esaj.tjsp.jus.br/pastadigital/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "bulk_download_selection.js",
        "injected.js"
      ],
      "matches": [
        "https://esaj.tjsp.jus.br/*"
      ]
    }
  ]
}
